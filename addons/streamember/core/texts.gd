## Falcon error code → text key.
const ERRORS := {
	"invalid_credentials": "e_invalid_credentials", "email_not_verified": "e_email_not_verified",
	"account_suspended": "e_account_suspended", "rate_limited": "e_rate_limited", "network": "e_network",
	"code_invalid": "e_code_invalid", "password_too_short": "e_password_too_short", "password_too_weak": "e_password_too_weak",
	"game_not_found": "e_game_not_found", "game_access_denied": "e_game_not_found", "game_unavailable": "e_game_not_found",
	"fields_required": "e_fields_required", "use_launcher": "use_launcher",
}


## Index into a T row for the game's current locale ("tr", "pt_BR", "zh_TW" …).
static func index() -> int:
	var locale := TranslationServer.get_locale()
	var lang := locale.get_slice("_", 0).get_slice("-", 0).to_lower()
	if lang == "zh":
		lang = "zh_Hant" if locale.contains("Hant") or locale.contains("TW") or locale.contains("HK") or locale.contains("MO") else "zh_Hans"
	return maxi(LANGS.find(lang), 0)


static func get_text(key: String) -> String:
	var row: Array = T.get(key, [])
	if row.is_empty():
		return key
	return str(row[index()])


## Text for a Falcon / core error code.
static func error(code: String) -> String:
	if ERRORS.has(code):
		return get_text(ERRORS[code])
	return get_text("e_other") % code
